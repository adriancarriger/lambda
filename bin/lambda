#!/usr/bin/env node
const { run } = require('../dist/cli.js');

// Deviation: this calls run(), which builds the program with the exported
// createProgram(), rather than calling createProgram() itself. The dispatch
// has to see argv before commander parses it: an unknown command must reach
// the project CLI with flags commander would otherwise reject or consume, and
// a drop-in has to be loaded (asynchronously, through jiti or import()) and
// registered before parsing, in place of the built-in it replaces.

run(process.argv).then((code) => {
  process.exitCode = code;
});
